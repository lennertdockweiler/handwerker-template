---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionRenderer from '@/components/sections/SectionRenderer.astro';
import { site } from '@/lib/config';
import { getImage } from '@/lib/images';
import { pageTitle, homeDescription, faqPage } from '@/lib/seo';

const sektionen = site.sektionen;
const hero = sektionen.find((s) => s.typ === 'hero');
const heroFirst = sektionen[0]?.typ === 'hero';
// Header liegt nur über dunklen Bild-Heros transparent
const overlay = heroFirst && hero?.layout === 'vollbild';
const lcp = hero?.layout === 'vollbild' ? (hero.video?.poster ?? hero.bild ?? site.leistungen[0]?.bilder[0]) : hero?.layout === 'split' ? (hero.bilder?.[0] ?? site.leistungen[0]?.bilder[0]) : undefined;
const hatFaq = sektionen.some((s) => s.typ === 'faq');
---

<BaseLayout
  title={pageTitle(undefined, 'start')}
  description={homeDescription()}
  path="/"
  ogKey="start"
  headerOverlay={overlay}
  preloadImage={getImage(lcp?.datei)}
  preloadSizes={hero?.layout === 'split' ? '(min-width: 1024px) 34vw, 70vw' : '100vw'}
  preloadWidths={hero?.layout === 'split' ? [480, 720, 960, 1200] : [640, 960, 1280, 1680, 2200]}
  jsonLd={[hatFaq ? faqPage(site.faq) : null]}
>
  {sektionen.map((s) => <SectionRenderer s={s} />)}
</BaseLayout>
