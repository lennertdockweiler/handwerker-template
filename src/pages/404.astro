---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Icon from '@/components/ui/Icon.astro';
import { site } from '@/lib/config';
import { ui } from '@/data/ui';
import { telHref, telAnzeige } from '@/lib/text';
import { pageTitle } from '@/lib/seo';
import { withBase } from '@/lib/paths';
---

<BaseLayout title={pageTitle(ui.notFound.titel)} description={ui.notFound.text} path="/404/" ogKey="start" noindex>
  <Section class="nf" ton={site.config.branding.stilPreset === 'kraftvoll-bold' ? 'marke' : 'hell'}>
    <div class="container-x nf__in">
      <p class="nf__code tabular" aria-hidden="true">{ui.notFound.code}</p>
      <h1 class="h1">{ui.notFound.titel}</h1>
      <p class="lead">{ui.notFound.text}</p>
      <ul class="nf__links">
        <li><a href={withBase('/')} class="chip">{ui.nav.start}</a></li>
        {site.nav.map((n) => <li><a href={n.href} class="chip">{n.label}</a></li>)}
      </ul>
      <a href={telHref(site.config.betrieb.telefon)} class="btn btn--lg"><Icon name="phone" />{telAnzeige(site.config.betrieb.telefon)}</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .nf {
    min-height: 90svh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--header-h) + var(--space-2xl));
  }
  .nf__in {
    display: grid;
    gap: var(--space-l);
    justify-items: start;
  }
  .nf__code {
    font-family: var(--font-head);
    font-weight: var(--head-weight);
    font-size: var(--step-7);
    line-height: 0.8;
    color: var(--c-accent-raw);
    letter-spacing: -0.05em;
  }
  .nf__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .nf__links a {
    text-decoration: none;
  }
</style>
