---
/**
 * Vorher/Nachher-Slider: Maus, Touch, Pfeiltasten (role="slider").
 * Ohne JS: 50/50-Ansicht mit Beschriftung. Einmaliges „Hinweis-Wackeln“
 * beim ersten Sichtbarwerden (nicht bei Reduced Motion).
 */
import type { Bild } from '@/lib/config';
import { ui } from '@/data/ui';
import Img from '@/components/ui/Img.astro';

interface Props {
  vorher: Bild;
  nachher: Bild;
  ratio?: string;
  class?: string;
}
const { vorher, nachher, ratio = '16/10', class: cls = '' } = Astro.props;
---

<figure class:list={['ba', cls]} data-before-after style={`--pos:50%;aspect-ratio:${ratio}`}>
  <Img bild={nachher} ratio="auto" sizes="(min-width: 1024px) 80vw, 100vw" class="ba__img ba__img--after" tint={false} />
  <div class="ba__before" aria-hidden="false">
    <Img bild={vorher} ratio="auto" sizes="(min-width: 1024px) 80vw, 100vw" class="ba__img" tint={false} />
  </div>
  <span class="ba__tag ba__tag--l label">{ui.vorherNachher.vorher}</span>
  <span class="ba__tag ba__tag--r label">{ui.vorherNachher.nachher}</span>
  <div
    class="ba__handle"
    role="slider"
    tabindex="0"
    aria-label={ui.vorherNachher.regler}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-valuetext="50 %"
    data-ba-handle
  >
    <span class="ba__knob" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6"></path></svg>
    </span>
  </div>
</figure>

<style>
  .ba {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-img);
    user-select: none;
    touch-action: pan-y;
    background: var(--n-200);
    cursor: ew-resize;
  }
  .ba :global(.ba__img) {
    position: absolute;
    inset: 0;
    border-radius: 0;
  }
  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
    will-change: clip-path;
  }
  .ba__tag {
    position: absolute;
    top: var(--space-s);
    z-index: 4;
    padding: 0.35rem 0.7rem;
    border-radius: var(--r-btn);
    background: rgb(0 0 0 / 0.62);
    color: #fff;
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .ba__tag--l {
    left: var(--space-s);
  }
  .ba__tag--r {
    right: var(--space-s);
  }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 5;
    width: 44px;
    margin-left: -22px;
    display: grid;
    place-items: center;
    outline: none;
  }
  .ba__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15);
  }
  .ba__knob {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--c-accent);
    color: var(--c-on-accent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.3);
    transition: transform 240ms var(--ease-out);
  }
  html[data-preset='modern-praezise'] .ba__knob {
    border-radius: 0;
  }
  .ba__handle:focus-visible .ba__knob {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .ba.is-dragging .ba__knob {
    transform: scale(1.1);
  }
</style>
