---
/**
 * Lucide-Icon als Inline-SVG (serverseitig gerendert, kein Client-JS).
 * Social-Marken fehlen in Lucide; sie sind hier im gleichen Strichstil ergänzt.
 */
import nodes from 'lucide-static/icon-nodes.json';

type Node = [string, Record<string, string | number>];
interface Props {
  name: string;
  size?: number | string;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const BRAND: Record<string, Node[]> = {
  instagram: [
    ['rect', { x: 2, y: 2, width: 20, height: 20, rx: 5, ry: 5 }],
    ['path', { d: 'M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z' }],
    ['line', { x1: 17.5, y1: 6.5, x2: 17.51, y2: 6.5 }],
  ],
  facebook: [['path', { d: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' }]],
  linkedin: [
    ['path', { d: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z' }],
    ['rect', { x: 2, y: 9, width: 4, height: 12 }],
    ['circle', { cx: 4, cy: 4, r: 2 }],
  ],
  youtube: [
    ['path', { d: 'M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17' }],
    ['path', { d: 'm10 15 5-3-5-3z' }],
  ],
  whatsapp: [
    ['path', { d: 'M7.9 20A9 9 0 1 0 4 16.1L2 22Z' }],
    ['path', { d: 'M9.5 9.5c.3 1.6 1.6 3.6 3.6 4.6l1.2-1.1 2 .9-.4 1.7c-3.6.4-7.6-3.4-7.4-7.1l1.7-.4.9 2z' }],
  ],
  xing: [['path', { d: 'M5 6l3 5-4 7M15 3l-6 10.5L13 21M19 3l-6 10.5' }]],
  tiktok: [['path', { d: 'M15 3v11a4 4 0 1 1-4-4M15 3a5 5 0 0 0 5 5' }]],
};

const { name, size = 24, class: cls = '', label, strokeWidth = 1.75 } = Astro.props;
const all = nodes as unknown as Record<string, Node[]>;
const node: Node[] = BRAND[name] ?? all[name] ?? all['circle-dot'] ?? [];
const attrs = (o: Record<string, string | number>) =>
  Object.entries(o)
    .map(([k, v]) => `${k}="${String(v)}"`)
    .join(' ');
const inner = node.map(([tag, a]) => `<${tag} ${attrs(a)}/>`).join('');
---

<svg
  class:list={['icon', cls]}
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={inner}
/>
