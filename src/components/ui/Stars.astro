---
import { ui } from '@/data/ui';
import { fill } from '@/lib/text';

interface Props {
  wert: number;
  size?: number;
  class?: string;
}
const { wert, size = 16, class: cls = '' } = Astro.props;
const label = fill(ui.barrierefrei.sterne, { n: String(wert).replace('.', ',') });
const id = `sg${Math.round(wert * 10)}`;
---

<span class:list={['stars', cls]} role="img" aria-label={label}>
  {
    [0, 1, 2, 3, 4].map((i) => {
      const fillPct = Math.max(0, Math.min(1, wert - i));
      return (
        <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
          {fillPct > 0 && fillPct < 1 && (
            <defs>
              <linearGradient id={`${id}-${i}`}>
                <stop offset={fillPct} stop-color="currentColor" />
                <stop offset={fillPct} stop-color="currentColor" stop-opacity="0.25" />
              </linearGradient>
            </defs>
          )}
          <path
            d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"
            fill={fillPct >= 1 ? 'currentColor' : fillPct > 0 ? `url(#${id}-${i})` : 'currentColor'}
            fill-opacity={fillPct > 0 ? 1 : 0.25}
          />
        </svg>
      );
    })
  }
</span>
