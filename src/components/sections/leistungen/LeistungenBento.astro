---
/** Leistungen a) Bento-Grid: große Bildkacheln + ruhige Icon-Kacheln */
import { site, sb, t, type Sektion } from '@/lib/config';
import { ui } from '@/data/ui';
import Section from '@/components/ui/Section.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Img from '@/components/ui/Img.astro';
import Icon from '@/components/ui/Icon.astro';
import { bentoLayout } from './bento';

interface Props {
  s: Extract<Sektion, { typ: 'leistungen' }>;
}
const { s } = Astro.props;
const list = site.leistungen;
const tiles = bentoLayout(list.length);
---

<Section ton={s.ton} id={s.id}>
  <div class="container-x">
    <SectionHead titel={s.ueberschrift ? t(s.ueberschrift) : sb('leistungenTitel')} intro={s.intro ? t(s.intro) : sb('leistungenIntro')} split>
      {site.seiten.leistungen && <a href={site.links.leistungen} class="link-u link-u--static bento__all">{ui.cta.alleLeistungen}</a>}
    </SectionHead>
    <ul class="bento" data-anim-stagger>
      {
        list.map((l, i) => {
          const tile = tiles[i]!;
          const big = tile.w >= 2;
          return (
            <li class:list={['bento__item', `bw-${tile.w}`, `bh-${tile.h}`, { 'is-media': big }]}>
              <a href={site.links.leistung(l.slug)} class="bento__link">
                {big ? (
                  <Img
                    bild={l.bilder[0]}
                    motiv={l.motiv}
                    ratio="auto"
                    sizes={tile.w === 4 ? '100vw' : '(min-width: 1024px) 50vw, 100vw'}
                    class="bento__media"
                    decorative
                    transitionName={`leistung-${l.slug}`}
                  />
                ) : (
                  <Icon name={l.icon} size={36} class="bento__icon" strokeWidth={1.4} />
                )}
                <span class="bento__body">
                  <h3 class="h4 bento__title">{l.titel}</h3>
                  <span class="bento__text">{l.kurztext}</span>
                </span>
                <span class="bento__go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Section>

<style>
  .bento__all {
    font-weight: 650;
    justify-self: start;
  }
  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-s);
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento__item.is-media {
      grid-column: span 2;
    }
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(15rem, auto);
      grid-auto-flow: dense;
    }
    .bento__item.bw-1 { grid-column: span 1; }
    .bento__item.bw-2 { grid-column: span 2; }
    .bento__item.bw-4 { grid-column: span 4; }
    .bento__item.bh-2 { grid-row: span 2; }
  }
  .bento__item {
    position: relative;
    min-height: 13rem;
  }
  .bento__link {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-l);
    height: 100%;
    padding: var(--space-l);
    border-radius: var(--r-l);
    background: var(--s-card);
    border: 1px solid var(--s-line);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color var(--dur) var(--ease-out);
  }
  .bento__link:hover {
    border-color: color-mix(in oklab, var(--s-ink) 50%, transparent);
  }
  .bento__icon {
    color: var(--s-accent);
  }
  .bento__body {
    display: grid;
    gap: 0.5rem;
    max-width: 34ch;
  }
  .bento__text {
    color: var(--s-ink-soft);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .bento__go {
    position: absolute;
    top: var(--space-m);
    right: var(--space-m);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-btn);
    background: var(--c-accent);
    color: var(--c-on-accent);
    transform: scale(0.6) rotate(-45deg);
    opacity: 0;
    transition:
      transform 420ms var(--ease-out),
      opacity 260ms var(--ease-out);
  }
  .bento__link:hover .bento__go,
  .bento__link:focus-visible .bento__go {
    transform: none;
    opacity: 1;
  }
  @media (hover: none) {
    .bento__go {
      transform: none;
      opacity: 1;
    }
  }

  /* Bildkacheln */
  .is-media {
    min-height: 20rem;
  }
  .is-media .bento__link {
    justify-content: flex-end;
    color: #fff;
    border: 0;
    background: var(--c-dark);
  }
  .is-media :global(.bento__media) {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 0;
  }
  .is-media :global(.bento__media img) {
    transition: transform 900ms var(--ease-out);
  }
  .is-media .bento__link:hover :global(.bento__media img) {
    transform: scale(1.05);
  }
  .is-media .bento__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent 30%, rgb(0 0 0 / 0.78) 100%);
  }
  .is-media .bento__text {
    color: rgb(255 255 255 / 0.86);
  }
  .is-media.bh-2 .bento__title {
    font-size: var(--step-3);
  }
  html[data-preset='modern-praezise'] .bento__link {
    border-radius: 0;
  }
  html[data-preset='kraftvoll-bold'] .bento__item:not(.is-media) .bento__link {
    border: 2px solid var(--s-ink);
  }
  html[data-preset='kraftvoll-bold'] .bento__item:not(.is-media):nth-child(3n + 2) .bento__link {
    background: var(--c-brand);
    color: var(--c-on-brand);
    --s-ink-soft: var(--c-on-brand);
    --s-accent: var(--c-on-brand);
  }
</style>
